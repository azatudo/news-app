{
  "compilerOptions": {
    "baseUrl": ".",

    "paths": {
      "@/*": ["src/*"]
    },

    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "lib": ["ES2020", "DOM"],

    "jsx": "react-jsx",

    "skipLibCheck": true,
    "strict": false,
    "noEmit": true
  },
  "include": ["src"]
}